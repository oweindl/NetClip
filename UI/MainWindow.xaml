<ui:FluentWindow
    x:Class="NetClip.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:NetClip.ViewModels"
    Title="NetClip"
    Height="720" Width="980" MinHeight="480" MinWidth="680"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate DataType="{x:Type vm:TextFeedItem}">
            <ui:Card Margin="0,0,0,10" Padding="16,12" HorizontalAlignment="Stretch">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding HeaderText}" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <ui:Button Grid.Column="1" Appearance="Transparent" Padding="6" Width="30" Height="30"
                                   Icon="{ui:SymbolIcon Copy20}" ToolTip="Copy to clipboard"
                                   Click="CopyText_Click" />
                    </Grid>
                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" TextWrapping="Wrap" Padding="0" Margin="0,6,0,0"
                             FontSize="14" IsReadOnlyCaretVisible="False" />
                </StackPanel>
            </ui:Card>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FileFeedItem}">
            <ui:Card Margin="0,0,0,10" Padding="16,12" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="Document24" Margin="0,2,12,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding HeaderText}" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding FileName}" FontWeight="Medium" FontSize="14" Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="{Binding FileSizeText, Mode=OneWay}" /><Run Text="  ·  " /><Run
                                Text="{Binding StatusText, Mode=OneWay}" />
                        </TextBlock>
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="100" Height="4"
                                     Margin="0,8,0,0"
                                     Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                    Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}">
                            <ui:Button Content="Open" Appearance="Secondary" Padding="12,5" FontSize="12"
                                       Margin="0,0,8,0" Click="OpenFile_Click" />
                            <ui:Button Content="Show in folder" Icon="{ui:SymbolIcon FolderOpen20}"
                                       Appearance="Secondary" Padding="12,5" FontSize="12"
                                       Click="ShowFolder_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ui:Card>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="NetClip">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="ClipboardChatEmpty24" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <ui:Button x:Name="ThemeToggleButton" Appearance="Transparent" Width="36" Height="32"
                           Margin="0,0,4,0" Click="ThemeToggleButton_Click" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <!-- ================= START PAGE ================= -->
            <Grid x:Name="StartPage" Background="{DynamicResource ApplicationBackgroundBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Width="380">
                    <ui:SymbolIcon Symbol="ClipboardChatEmpty24" FontSize="52" HorizontalAlignment="Center"
                                   Margin="0,0,0,16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="NetClip" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Share text and files across machines on your network." FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,6,0,32" />
                    <ui:Button Content="Host a Session" Icon="{ui:SymbolIcon Server24}" Appearance="Primary"
                               HorizontalContentAlignment="Left" Padding="18,15" FontSize="14.5"
                               Margin="0,0,0,12" Click="HostButton_Click" />
                    <ui:Button Content="Join a Session" Icon="{ui:SymbolIcon PlugConnected24}"
                               Appearance="Secondary" HorizontalContentAlignment="Left" Padding="18,15"
                               FontSize="14.5" Click="JoinButton_Click" />
                </StackPanel>
            </Grid>

            <!-- ================= HOST SETUP PAGE ================= -->
            <Grid x:Name="HostPage" Visibility="Collapsed" Background="{DynamicResource ApplicationBackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="460" Margin="32" HorizontalAlignment="Center">
                        <TextBlock Text="Host a Session" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Start listening for other machines to join." FontSize="12.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20" />

                        <ui:Card Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Your display name" FontWeight="Medium" Margin="0,0,0,6" />
                                <ui:TextBox x:Name="TxtHostName" PlaceholderText="e.g. Alice" Margin="0,0,0,18" />

                                <TextBlock Text="Passphrase (optional)" FontWeight="Medium" Margin="0,0,0,6" />
                                <ui:PasswordBox x:Name="PwdHostPassphrase" PlaceholderText="Leave blank for none"
                                                Margin="0,0,0,18" />

                                <TextBlock Text="TCP port" FontWeight="Medium" Margin="0,0,0,6" />
                                <ui:NumberBox x:Name="NumHostPort" Value="53535" Minimum="1024" Maximum="65535"
                                              Margin="0,0,0,18" />

                                <ui:ToggleSwitch x:Name="ToggleHostDiscovery"
                                                  Content="Announce this session on the local network"
                                                  IsChecked="True" />
                            </StackPanel>
                        </ui:Card>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="Back" Appearance="Secondary" Padding="16,9" Margin="0,0,8,0"
                                       Click="HostBack_Click" />
                            <ui:Button Content="Start Hosting" Icon="{ui:SymbolIcon Server24}"
                                       Appearance="Primary" Padding="16,9" Click="StartHosting_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= JOIN SETUP PAGE ================= -->
            <Grid x:Name="JoinPage" Visibility="Collapsed" Background="{DynamicResource ApplicationBackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="520" Margin="32" HorizontalAlignment="Center">
                        <TextBlock Text="Join a Session" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Connect to a machine that is already hosting." FontSize="12.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20" />

                        <ui:Card Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Discovered on this network" FontWeight="Medium" Margin="0,0,0,8" />
                                <ListView x:Name="LvHosts" Height="130" BorderThickness="0" Background="Transparent"
                                          SelectionChanged="LvHosts_SelectionChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Host" Width="160"
                                                            DisplayMemberBinding="{Binding DisplayName}" />
                                            <GridViewColumn Header="Address" Width="170"
                                                            DisplayMemberBinding="{Binding Address}" />
                                            <GridViewColumn Header="Passphrase" Width="90"
                                                            DisplayMemberBinding="{Binding PassphraseText}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Host address (IP:port)" FontWeight="Medium" Margin="0,0,0,6" />
                                <ui:TextBox x:Name="TxtManualAddress" PlaceholderText="192.168.1.23:53535"
                                            Margin="0,0,0,18" />

                                <TextBlock Text="Your display name" FontWeight="Medium" Margin="0,0,0,6" />
                                <ui:TextBox x:Name="TxtJoinName" PlaceholderText="e.g. Bob" Margin="0,0,0,18" />

                                <TextBlock Text="Passphrase" FontWeight="Medium" Margin="0,0,0,6" />
                                <ui:PasswordBox x:Name="PwdJoinPassphrase" PlaceholderText="If required by host" />
                            </StackPanel>
                        </ui:Card>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtJoinStatus" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:Button Content="Back" Appearance="Secondary" Padding="16,9" Margin="0,0,8,0"
                                       Click="JoinBack_Click" />
                            <ui:Button x:Name="BtnConnect" Content="Connect"
                                       Icon="{ui:SymbolIcon PlugConnected24}" Appearance="Primary" Padding="16,9"
                                       Click="ConnectButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= SESSION PAGE ================= -->
            <Grid x:Name="SessionPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                        Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtRole" FontSize="14.5" FontWeight="SemiBold" />
                            <TextBlock x:Name="TxtParticipants" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" x:Name="ToggleAutoCopy"
                                          Content="Auto-copy incoming text" IsChecked="False"
                                          Margin="20,0" VerticalAlignment="Center" />
                        <ui:Button Grid.Column="2" Content="Leave" Appearance="Secondary"
                                   Icon="{ui:SymbolIcon SignOut24}" VerticalAlignment="Center"
                                   Padding="14,8" Click="Leave_Click" />
                    </Grid>
                </Border>

                <ScrollViewer x:Name="FeedScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                              AllowDrop="True" DragEnter="Feed_DragEnter" DragOver="Feed_DragEnter"
                              Drop="Feed_Drop">
                    <ItemsControl x:Name="FeedItemsControl" Margin="20,16,20,16" />
                </ScrollViewer>

                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" x:Name="TxtInput"
                                    PlaceholderText="Type a message and press Enter · or drag files anywhere above"
                                    AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100"
                                    VerticalContentAlignment="Center" KeyDown="TxtInput_KeyDown" />
                        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Send24}" Appearance="Primary"
                                   Margin="8,0,0,0" Width="44" Click="Send_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
